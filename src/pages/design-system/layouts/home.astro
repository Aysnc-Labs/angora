---
import FullScreen from '../_layout/FullScreen.astro';
import Section from '@/components/Section.astro';
import CardGrid from '@/components/CardGrid.astro';
import Card from '@/components/Card/Card.astro';
import CardBody from '@/components/Card/CardBody.astro';
import CardEyebrow from '@/components/Card/CardEyebrow.astro';
import CardTitle from '@/components/Card/CardTitle.astro';
import CardDescription from '@/components/Card/CardDescription.astro';
---

<FullScreen title="Home Layout">
  <main class="section-flow">

    <!-- Features -->
    <Section title="Built for modern teams" seamless class="bg-muted">
      <CardGrid>
        <Card>
          <CardBody>
            <CardTitle>Lightning fast</CardTitle>
            <CardDescription>Sub-100ms response times with edge computing and intelligent caching.</CardDescription>
          </CardBody>
        </Card>
        <Card>
          <CardBody>
            <CardTitle>Secure by default</CardTitle>
            <CardDescription>End-to-end encryption, SOC 2 compliance, and automatic key rotation.</CardDescription>
          </CardBody>
        </Card>
        <Card>
          <CardBody>
            <CardTitle>Global scale</CardTitle>
            <CardDescription>Deploy to 30+ regions with one click. Automatic failover and load balancing.</CardDescription>
          </CardBody>
        </Card>
      </CardGrid>
    </Section>

    <!-- Testimonials -->
    <Section title="What people are saying">
      <CardGrid columns={2}>
        <Card variant="flat">
          <CardBody>
            <CardTitle as="p">"This completely changed how we think about our marketing pipeline. The analytics alone paid for itself in the first month."</CardTitle>
            <CardDescription>Sarah Chen, VP Marketing at Acme Corp</CardDescription>
          </CardBody>
        </Card>
        <Card variant="flat">
          <CardBody>
            <CardTitle as="p">"We cut our deploy time from 45 minutes to under 3. The team hasn't looked back since."</CardTitle>
            <CardDescription>Marcus Rivera, CTO at Wavelength</CardDescription>
          </CardBody>
        </Card>
      </CardGrid>
    </Section>

    <!-- Blog -->
    <Section title="From the blog" seamless class="bg-muted">
      <CardGrid>
        <Card>
          <CardBody>
            <CardEyebrow>Engineering</CardEyebrow>
            <CardTitle>Building reliable distributed systems</CardTitle>
            <CardDescription>How we scaled our infrastructure to handle 10x traffic growth.</CardDescription>
          </CardBody>
        </Card>
        <Card>
          <CardBody>
            <CardEyebrow>Product</CardEyebrow>
            <CardTitle>Announcing our new dashboard</CardTitle>
            <CardDescription>A redesigned analytics experience with real-time insights.</CardDescription>
          </CardBody>
        </Card>
        <Card>
          <CardBody>
            <CardEyebrow>Design</CardEyebrow>
            <CardTitle>Our approach to accessible color</CardTitle>
            <CardDescription>Why we rebuilt our palette around WCAG AA from day one.</CardDescription>
          </CardBody>
        </Card>
      </CardGrid>
    </Section>

  </main>
</FullScreen>
